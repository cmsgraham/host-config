#!/usr/bin/env bash
# fxplat-binance-mirror (2026-10-22): the fxplat-crypto node runs on docker1 (home BRIX 192.168.1.43). Every 5 min copy
# its public output home for the Brókers view and fxplat-health:
#   recorder  /opt/fxplat-crypto/binance-data/{hourly,trades,fees,status.json} -> ~/.cache/fxplat/brokers/binance/
#   trader    /opt/fxplat-crypto/trader-data/{status.json,smoke}              -> ~/.cache/fxplat/brokers/binance-trader/
# Only those named entries travel; env files live outside the data dirs and are never copied. Modeled on
# fxplat-ctrader-mirror. Install: cp to ~/.local/bin/ (chmod +x), the .service to ~/.config/systemd/user/, then
#          systemctl --user daemon-reload && systemctl --user enable --now fxplat-binance-mirror
set -u
HOST=${DOCKER1:-cmsgraham@192.168.1.43}
OUT=~/.cache/fxplat/brokers
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=15 -o ControlMaster=auto -o ControlPath=~/.ssh/cm-docker1-%C -o ControlPersist=10m "$HOST")
# data dirs are nobody:700 on docker1, hence sudo -n sh -c
pull() {  # $1 remote dir, $2 local dir, $3 entries
  local T; mkdir -p "$2"; T=$(mktemp -d "$2/.in.XXXXXX")
  local remote="cd $1 && tar -czf - --exclude=.* --exclude=*.env \$(ls -d $3 2>/dev/null)"
  if "${SSH[@]}" "sudo -n sh -c '$remote'" 2>/dev/null | tar -C "$T" -xzf - 2>/dev/null && [ -s "$T/status.json" ]; then
    find "$T" -name '*.env' -delete
    for d in $3; do
      [ "$d" = status.json ] && continue
      [ -d "$T/$d" ] && mkdir -p "$2/$d" && find "$T/$d" -maxdepth 1 -type f -exec mv -f {} "$2/$d/" \;
    done
    mv -f "$T/status.json" "$2/status.json"
  fi
  rm -rf "$T"
}
# sourced with MIRROR_SOURCE_ONLY=1 (tests): define pull() only
[ "${MIRROR_SOURCE_ONLY:-}" = 1 ] && return 0 2>/dev/null
while true; do
  pull /opt/fxplat-crypto/binance-data "$OUT/binance" "hourly trades fees status.json"
  pull /opt/fxplat-crypto/trader-data "$OUT/binance-trader" "smoke status.json"
  sleep 300
done
