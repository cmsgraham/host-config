#!/usr/bin/env bash
# fxplat-health (2026-10-14): what the agent-ci watchdog does NOT watch. Every 30 min (user timer
# fxplat-health.timer); one phone alert per new problem (state in ~/.cache/fxplat-health), cleared when fixed.
# Checks: the dashboard can load the task files (2026-10-14 it showed 0 tasks for hours after a loader change),
# the data download, the IB price feed, the website publisher, the replay builder, and the loop being alive.
set -u
STATE=~/.cache/fxplat-health; mkdir -p "$STATE"
NOTIFY="$HOME/agent-ci/.venv/bin/agent-ci --config $HOME/Dukascopy/config.yaml notify"
problems=()

# 1. dashboard / loader: the gateway's agent-ci feed loads every task file
st=$(curl -s -m 30 "http://127.0.0.1:11434/_dash/agentci/status?project=fxplat" || true)
err=$(printf '%s' "$st" | python3 -c 'import json,sys
try:
  d=json.load(sys.stdin); n=len(d.get("tasks") or []); e=d.get("tasks_error")
  print(("tasks_error: "+str(e)[:160]) if e else ("no tasks returned" if n==0 else ""))
except Exception as x: print("status feed unreadable")' 2>/dev/null)
[ -n "$err" ] && problems+=("dashboard|agent-ci dashboard: $err")

# 2. data download (hourly fxplat-update): not failed, and its log moved in the last 3 h
systemctl --user is-failed --quiet fxplat-update.service && problems+=("update|fxplat-update.service FAILED")
log=~/fxdata/update.log
if [ -f "$log" ] && [ $(( $(date +%s) - $(stat -c %Y "$log") )) -gt 10800 ]; then
  problems+=("updatelog|data download log silent for over 3 h ($log)")
fi

# 3. services that must stay up
# IB feed: on fxplat-server since the 2026-10-14 cutover (home mirror), else the home gateway units
if systemctl --user is-enabled --quiet fxplat-live-mirror 2>/dev/null; then
  ibunits="fxplat-live-mirror"; ml=~/.cache/fxplat/live/market-live.json
else
  ibunits="fxplat-xvfb fxplat-ib-gateway fxplat-ib-market"; ml=~/.cache/fxplat/bundle/market-live.json
fi
for u in $ibunits fxplat-publish fxplat-replay; do
  systemctl --user is-active --quiet "$u" || problems+=("$u|$u is not running")
done
for u in ollama ollama-gateway; do
  systemctl is-active --quiet "$u" || problems+=("$u|$u (system) is not running")
done

# 4. IB live quotes fresh (market-live.json written every 15 s; alert past 10 min on weekdays)
dow=$(date -u +%u)
if [ "$dow" -le 5 ] && [ -f "$ml" ] && [ $(( $(date +%s) - $(stat -c %Y "$ml") )) -gt 600 ]; then
  problems+=("marketlive|IB live quotes stale for over 10 min (market-live.json)")
fi

# 5. the build loop alive (the watchdog restarts it; this catches the watchdog itself failing)
pgrep -f "[a]gent_ci.cli --config $HOME/Dukascopy/config.yaml auto" >/dev/null || {
  f="$STATE/noloop.since"; [ -f "$f" ] || date +%s > "$f"
  [ $(( $(date +%s) - $(cat "$f") )) -gt 2700 ] && problems+=("noloop|no agent-ci loop running for over 45 min")
}
pgrep -f "[a]gent_ci.cli --config $HOME/Dukascopy/config.yaml auto" >/dev/null && rm -f "$STATE/noloop.since"

# alert once per new problem; clear the marker when it is gone
now_keys=()
for p in "${problems[@]}"; do
  k=${p%%|*}; msg=${p#*|}; now_keys+=("$k")
  if [ ! -f "$STATE/$k.alerted" ]; then
    $NOTIFY --priority 4 "fxplat health: $k" "$msg" >/dev/null 2>&1 && touch "$STATE/$k.alerted"
  fi
  echo "PROBLEM $k: $msg"
done
for f in "$STATE"/*.alerted; do
  [ -e "$f" ] || continue; k=$(basename "$f" .alerted)
  [[ " ${now_keys[*]} " == *" $k "* ]] || { rm -f "$f"; $NOTIFY --priority 2 "fxplat health: $k OK" "resolved" >/dev/null 2>&1; echo "RESOLVED $k"; }
done
[ ${#problems[@]} -eq 0 ] && echo "fxplat health OK $(date '+%F %R')"
exit 0
