# UNCONFIGURED FSTAB FOR BASE SYSTEM
# 2026-11-11: git backups go to the NAS share msi31-backup as the backup-only NAS user (cifs + /etc/samba/nas1.cred), mounted from Linux so it works with no Windows logon; /mnt/z (Main) stays drvfs
//192.168.1.201/main /mnt/z drvfs uid=1000,gid=1000,metadata,nofail 0 0
//192.168.1.201/msi31-backup /mnt/nas-backup cifs credentials=/etc/samba/nas1.cred,uid=1000,gid=1000,iocharset=utf8,vers=3.0,nofail,_netdev,x-systemd.automount,x-systemd.mount-timeout=30 0 0
192.168.1.200:/volumeUSB1/usbshare /mnt/nas-usb nfs vers=3,rsize=131072,wsize=131072,hard,timeo=600,nofail,_netdev 0 0
