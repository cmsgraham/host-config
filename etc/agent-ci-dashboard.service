[Unit]
Description=agent-ci read-only dashboard (x-scraping-project) on 127.0.0.1:8765
After=network-online.target
Wants=network-online.target

[Service]
User=cmadrigal
WorkingDirectory=/home/cmadrigal/agent-ci
ExecStart=/home/cmadrigal/agent-ci/.venv/bin/agent-ci --config /mnt/c/Users/crist/x-scraping-project/config.yaml dashboard --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
