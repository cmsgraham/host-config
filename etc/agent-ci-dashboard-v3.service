[Unit]
Description=agent-ci read-only dashboard (snoopy_frog v3) on 127.0.0.1:8766
After=network-online.target
Wants=network-online.target

[Service]
User=cmadrigal
WorkingDirectory=/home/cmadrigal/agent-ci
ExecStart=/home/cmadrigal/agent-ci/.venv/bin/agent-ci --config /mnt/c/Users/crist/snoopy_frog/v3/config.yaml dashboard --host 127.0.0.1 --port 8766
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
