diff --git a/server/sched_vram_recovery_test.go b/server/sched_vram_recovery_test.go
new file mode 100644
index 0000000..8502520
--- /dev/null
+++ b/server/sched_vram_recovery_test.go
@@ -0,0 +1,131 @@
+package server
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/ollama/ollama/format"
+	"github.com/ollama/ollama/ml"
+)
+
+// waitForVRAMRecovery must not poll GPU discovery in a loop: after unload()
+// every getGpuFn call is a full bootstrap discovery that launches GPU-client
+// subprocesses. Expect the pre-unload baseline plus exactly one refresh.
+func TestWaitForVRAMRecoveryProbesOnce(t *testing.T) {
+	const window = 2 * time.Second // the old 250ms ticker would have probed ~8 times
+
+	for _, tc := range []struct {
+		name        string
+		recovered   bool
+		minDuration time.Duration
+		maxDuration time.Duration
+	}{
+		// Recovery seen by the mid-point probe: finish then, not at the deadline.
+		{"recovered", true, window / 2, window - 250*time.Millisecond},
+		// No recovery: wait out the window, without probing again.
+		{"not recovered", false, window, window + time.Second},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var calls atomic.Int32
+			s := &Scheduler{
+				waitForRecovery: window,
+				getGpuFn: func(ctx context.Context, _ []ml.FilteredRunnerDiscovery) []ml.DeviceInfo {
+					n := calls.Add(1)
+					free := uint64(1 * format.GibiByte)
+					if n > 1 && tc.recovered {
+						free = 24 * format.GibiByte
+					}
+					return []ml.DeviceInfo{{
+						DeviceID:    ml.DeviceID{ID: "0", Library: "CUDA"},
+						TotalMemory: 24 * format.GibiByte,
+						FreeMemory:  free,
+					}}
+				},
+			}
+			runner := &runnerRef{
+				gpus:         []ml.DeviceID{{ID: "0", Library: "CUDA"}},
+				discreteGPUs: true,
+				vramSize:     20 * format.GibiByte,
+			}
+
+			start := time.Now()
+			finished := s.waitForVRAMRecovery(runner, nil)
+			select {
+			case <-finished:
+			case <-time.After(window + 5*time.Second):
+				t.Fatal("waitForVRAMRecovery did not finish")
+			}
+			elapsed := time.Since(start)
+
+			if got := calls.Load(); got != 2 {
+				t.Errorf("getGpuFn calls = %d, want 2 (baseline + one refresh)", got)
+			}
+			if elapsed < tc.minDuration || elapsed > tc.maxDuration {
+				t.Errorf("finished after %v, want between %v and %v", elapsed, tc.minDuration, tc.maxDuration)
+			}
+		})
+	}
+}
+
+// wslquiet P3: the one recovery probe must not be cancelled when the settle
+// window (waitForRecovery) expires while it is still running. Cancelling it
+// kills a GPU client mid-ioctl on WSL2 (dxg wait_for_completion failed).
+func TestWaitForVRAMRecoveryProbeOutlivesSettleDeadline(t *testing.T) {
+	const window = 1 * time.Second                // probe starts at 0.5s
+	const probeDuration = 1500 * time.Millisecond // still running at the 1s deadline
+
+	var calls atomic.Int32
+	var cancelledDuringProbe atomic.Bool
+	var probeDeadline atomic.Int64
+	s := &Scheduler{
+		waitForRecovery: window,
+		getGpuFn: func(ctx context.Context, _ []ml.FilteredRunnerDiscovery) []ml.DeviceInfo {
+			n := calls.Add(1)
+			if n > 1 {
+				if d, ok := ctx.Deadline(); ok {
+					probeDeadline.Store(int64(time.Until(d)))
+				}
+				select {
+				case <-ctx.Done():
+					cancelledDuringProbe.Store(true)
+				case <-time.After(probeDuration):
+				}
+			}
+			return []ml.DeviceInfo{{
+				DeviceID:    ml.DeviceID{ID: "0", Library: "CUDA"},
+				TotalMemory: 24 * format.GibiByte,
+				FreeMemory:  1 * format.GibiByte, // never recovers
+			}}
+		},
+	}
+	runner := &runnerRef{
+		gpus:         []ml.DeviceID{{ID: "0", Library: "CUDA"}},
+		discreteGPUs: true,
+		vramSize:     20 * format.GibiByte,
+	}
+
+	start := time.Now()
+	finished := s.waitForVRAMRecovery(runner, nil)
+	select {
+	case <-finished:
+	case <-time.After(window + 10*time.Second):
+		t.Fatal("waitForVRAMRecovery did not finish")
+	}
+	elapsed := time.Since(start)
+
+	if cancelledDuringProbe.Load() {
+		t.Error("recovery probe context was cancelled at the settle deadline")
+	}
+	if got := calls.Load(); got != 2 {
+		t.Errorf("getGpuFn calls = %d, want 2 (baseline + one refresh)", got)
+	}
+	if d := time.Duration(probeDeadline.Load()); d < vramRecoveryProbeTimeout-time.Second {
+		t.Errorf("probe context deadline in %v, want ~%v (independent of the %v settle window)", d, vramRecoveryProbeTimeout, window)
+	}
+	// Finishes when the probe returns (0.5s + 1.5s), not at the 1s deadline.
+	if min := window/2 + probeDuration; elapsed < min || elapsed > min+time.Second {
+		t.Errorf("finished after %v, want ~%v", elapsed, min)
+	}
+}
