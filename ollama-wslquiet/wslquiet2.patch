diff --git a/discover/probe_cancel_test.go b/discover/probe_cancel_test.go
new file mode 100644
index 0000000..d9b7c0a
--- /dev/null
+++ b/discover/probe_cancel_test.go
@@ -0,0 +1,107 @@
+//go:build linux
+
+package discover
+
+import (
+	"context"
+	"os/exec"
+	"testing"
+	"time"
+)
+
+// A cancelled discovery probe must get SIGTERM (so a probe that handles it can
+// leave its driver call and exit cleanly), not exec.CommandContext's SIGKILL.
+func TestDiscoveryProbeCancelSendsSIGTERM(t *testing.T) {
+	if _, err := exec.LookPath("sh"); err != nil {
+		t.Skip("sh not available")
+	}
+
+	ctx, cancel := context.WithCancel(t.Context())
+	// The child exits 42 only if it receives SIGTERM; SIGKILL cannot be trapped.
+	cmd := exec.CommandContext(ctx, "sh", "-c", `trap 'exit 42' TERM; echo ready; while :; do sleep 0.05; done`)
+	cmd.WaitDelay = llamaServerDiscoveryWaitDelay
+	setDiscoveryProbeCancel(cmd)
+
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 6)
+	if _, err := stdout.Read(buf); err != nil { // wait until the trap is installed
+		t.Fatal(err)
+	}
+
+	start := time.Now()
+	cancel()
+	err = cmd.Wait()
+
+	// ExitCode -1 means killed by a signal, i.e. the old SIGKILL behaviour.
+	if err == nil {
+		t.Fatal("Wait() = nil, want the probe's non-zero exit")
+	}
+	if got := cmd.ProcessState.ExitCode(); got != 42 {
+		t.Fatalf("exit code = %d (%v), want 42: the probe was not stopped with SIGTERM", got, cmd.ProcessState)
+	}
+	if elapsed := time.Since(start); elapsed >= llamaServerDiscoveryWaitDelay {
+		t.Fatalf("probe took %v to stop; SIGTERM should not need the WaitDelay fallback", elapsed)
+	}
+}
+
+// wslquiet P3: after system_info the --verbose probe is stopped with SIGTERM
+// (llama-server shuts down normally), and SIGKILLed only after the grace
+// period if it ignores SIGTERM.
+func TestStopDiscoveryProbe(t *testing.T) {
+	if _, err := exec.LookPath("sh"); err != nil {
+		t.Skip("sh not available")
+	}
+	start := func(t *testing.T, script string) *exec.Cmd {
+		cmd := exec.Command("sh", "-c", script+`; echo ready; while :; do sleep 0.05; done`)
+		stdout, err := cmd.StdoutPipe()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := cmd.Start(); err != nil {
+			t.Fatal(err)
+		}
+		buf := make([]byte, 6)
+		if _, err := stdout.Read(buf); err != nil { // trap installed
+			t.Fatal(err)
+		}
+		return cmd
+	}
+
+	t.Run("handles SIGTERM", func(t *testing.T) {
+		cmd := start(t, `trap 'exit 42' TERM`)
+		t0 := time.Now()
+		stopped, _ := stopDiscoveryProbe(cmd, 5*time.Second)
+		if !stopped {
+			t.Error("stopped = false")
+		}
+		if got := cmd.ProcessState.ExitCode(); got != 42 {
+			t.Fatalf("exit code = %d (%v), want 42: not stopped with SIGTERM", got, cmd.ProcessState)
+		}
+		if e := time.Since(t0); e >= 5*time.Second {
+			t.Fatalf("took %v; should not need the SIGKILL fallback", e)
+		}
+	})
+
+	t.Run("ignores SIGTERM", func(t *testing.T) {
+		cmd := start(t, `trap '' TERM`)
+		const grace = 300 * time.Millisecond
+		t0 := time.Now()
+		stopped, _ := stopDiscoveryProbe(cmd, grace)
+		e := time.Since(t0)
+		if !stopped {
+			t.Error("stopped = false")
+		}
+		if got := cmd.ProcessState.ExitCode(); got != -1 {
+			t.Fatalf("exit code = %d (%v), want -1 (SIGKILL fallback)", got, cmd.ProcessState)
+		}
+		if e < grace || e > grace+3*time.Second {
+			t.Fatalf("took %v, want ~%v", e, grace)
+		}
+	})
+}
