+// setDiscoveryProbeCancel makes a cancelled or expired context stop a
+// discovery probe with SIGTERM instead of exec.CommandContext's default
+// SIGKILL. cmd.WaitDelay (llamaServerDiscoveryWaitDelay) still SIGKILLs the
+// probe if it has not exited that long after the SIGTERM.
+//
+// The probes are GPU clients. On WSL2 their driver calls cross the dxgkrnl
+// paravirtualized GPU bridge, and SIGKILL during one of those calls abandons
+// the host request mid-flight ("dxgvmb_send_sync_msg: wait_for_completion
+// failed" in the guest kernel log; see microsoft/WSL#12756). SIGTERM lets a
+// probe that handles it (llama-server installs a SIGTERM handler) leave the
+// driver call and shut down normally. A probe without a handler (the
+// --list-devices path, the Go gpu-discover subprocess) still dies at once, as
+// before.
+//
+// Windows has no SIGTERM delivery for processes, so the default (Kill) stays.
+func setDiscoveryProbeCancel(cmd *exec.Cmd) {
+	if runtime.GOOS == "windows" {
+		return
+	}
+	cmd.Cancel = func() error {
+		return cmd.Process.Signal(syscall.SIGTERM)
+	}
+}
+
+// stopDiscoveryProbe ends a started discovery probe and reaps it, returning
+// whether a stop signal was delivered and cmd.Wait's error.
+//
+// wslquiet P3: upstream sent SIGKILL as soon as system_info had been read. The
+// probe is a GPU client; on WSL2 a SIGKILL while it is still inside a dxgkrnl
+// call (CUDA init/teardown) abandons the host request ("dxgvmb_send_sync_msg:
+// wait_for_completion failed", microsoft/WSL#12756). On non-Windows we now send
+// SIGTERM, which llama-server handles with a normal shutdown, and SIGKILL only
+// if it has not exited within grace (the existing WaitDelay). Windows keeps the
+// immediate Kill.
+func stopDiscoveryProbe(cmd *exec.Cmd, grace time.Duration) (bool, error) {
+	if runtime.GOOS == "windows" {
+		stopped := cmd.Process.Kill() == nil
+		return stopped, cmd.Wait()
+	}
+	if cmd.Process.Signal(syscall.SIGTERM) != nil {
+		// Already gone (or not signalable): fall back to the old path.
+		stopped := cmd.Process.Kill() == nil
+		return stopped, cmd.Wait()
+	}
+	waitCh := make(chan error, 1)
+	go func() { waitCh <- cmd.Wait() }()
+	select {
+	case err := <-waitCh:
+		return true, err
+	case <-time.After(grace):
+		slog.Debug("llama-server discovery: probe ignored SIGTERM, killing", "grace", grace)
+		_ = cmd.Process.Kill()
+		return true, <-waitCh
+	}
+}
