From 4d4f6c20e21df29c2e8554689452a4512bb6ac92 Mon Sep 17 00:00:00 2001
From: Cristian Madrigal <cristian.madrigal@gmail.com>
Date: Sat, 17 Oct 2026 08:00:20 -0600
Subject: [PATCH] discover/sched: fewer GPU discovery probes after unload;
 SIGTERM cancelled probes (WSL dxg)

P1 server/sched.go waitForVRAMRecovery: one GPU refresh at the mid-point of
the settle window instead of a bootstrap discovery every 250ms.
P2 discover: cancelled discovery probes get SIGTERM; WaitDelay remains the
SIGKILL fallback.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 discover/llama_server.go           | 27 ++++++++++++
 discover/native_probe.go           |  1 +
 discover/probe_cancel_test.go      | 51 ++++++++++++++++++++++
 server/sched.go                    | 68 ++++++++++++++++++-----------
 server/sched_vram_recovery_test.go | 70 ++++++++++++++++++++++++++++++
 5 files changed, 191 insertions(+), 26 deletions(-)
 create mode 100644 discover/probe_cancel_test.go
 create mode 100644 server/sched_vram_recovery_test.go

diff --git a/discover/llama_server.go b/discover/llama_server.go
index ba8ace5..e7a2d1d 100644
--- a/discover/llama_server.go
+++ b/discover/llama_server.go
@@ -13,6 +13,7 @@ import (
 	"runtime"
 	"strconv"
 	"strings"
+	"syscall"
 	"time"
 
 	"github.com/ollama/ollama/llm"
@@ -24,6 +25,30 @@ import (
 // the short-lived discovery subprocess.
 const llamaServerDiscoveryWaitDelay = 5 * time.Second
 
+// setDiscoveryProbeCancel makes a cancelled or expired context stop a
+// discovery probe with SIGTERM instead of exec.CommandContext's default
+// SIGKILL. cmd.WaitDelay (llamaServerDiscoveryWaitDelay) still SIGKILLs the
+// probe if it has not exited that long after the SIGTERM.
+//
+// The probes are GPU clients. On WSL2 their driver calls cross the dxgkrnl
+// paravirtualized GPU bridge, and SIGKILL during one of those calls abandons
+// the host request mid-flight ("dxgvmb_send_sync_msg: wait_for_completion
+// failed" in the guest kernel log; see microsoft/WSL#12756). SIGTERM lets a
+// probe that handles it (llama-server installs a SIGTERM handler) leave the
+// driver call and shut down normally. A probe without a handler (the
+// --list-devices path, the Go gpu-discover subprocess) still dies at once, as
+// before.
+//
+// Windows has no SIGTERM delivery for processes, so the default (Kill) stays.
+func setDiscoveryProbeCancel(cmd *exec.Cmd) {
+	if runtime.GOOS == "windows" {
+		return
+	}
+	cmd.Cancel = func() error {
+		return cmd.Process.Signal(syscall.SIGTERM)
+	}
+}
+
 // llamaServerDiscoverDevices spawns llama-server briefly (without a model) to
 // discover GPU devices and their capabilities. The server prints device info
 // and system_info (including compiled CUDA architectures) on startup before
@@ -64,6 +89,7 @@ func llamaServerDiscoverDevices(ctx context.Context, libDirs []string, extraEnvs
 		"--verbose",
 	)
 	cmd.WaitDelay = llamaServerDiscoveryWaitDelay
+	setDiscoveryProbeCancel(cmd)
 	cmd.Env = os.Environ()
 
 	llm.SetupLlamaServerCommandEnv(cmd, llamaServer, libDirs, extraEnvs)
@@ -142,6 +168,7 @@ func llamaServerDiscoverDevices(ctx context.Context, libDirs []string, extraEnvs
 	// (the brief server startup doesn't print that)
 	cmd2 := exec.CommandContext(ctx, llamaServer, "--list-devices", "--offline", "--verbose")
 	cmd2.WaitDelay = llamaServerDiscoveryWaitDelay
+	setDiscoveryProbeCancel(cmd2)
 	cmd2.Env = cmd.Env // reuse same environment
 	listOutput, err := cmd2.CombinedOutput()
 	_, _ = status.Write(listOutput)
