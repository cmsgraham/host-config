[Unit]
Description=Hourly: refresh host-config, push fxplat/agent-ci/ollama-gateway/host-config to the NAS (all branches) and to GitHub (fast-forward only)

[Service]
Type=oneshot
# 2026-11-11: one wrapper instead of a list of "-" steps (which hid ~28 h of NAS failures and let one GitHub push
# hang 3.5 h on the Windows credential manager after a no-logon reboot). Time limit per step, no prompts, NAS over
# cifs from Linux, GitHub over SSH (~/.ssh/github_backup), phone alert when the failing set changes.
# Previous unit: git-backup.service.bak-2026-11-11.
ExecStart=%h/.local/bin/git-backup-run
TimeoutStartSec=30min
Nice=10
